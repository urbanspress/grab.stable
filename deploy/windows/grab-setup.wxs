<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="GRAB"
           Manufacturer="Miles Development Experts LLC"
           Version="1.1.0.0"
           UpgradeCode="7B6E6E9E-8F4A-4B8B-9B7A-3C2A8E4D1F10"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="GRAB Programming Language &amp; Server Platform Installer"
                        Manufacturer="Miles Development Experts LLC" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of GRAB is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs Icon & Links -->
    <Icon Id="GrabIcon.ico" SourceFile="..\..\cmd\grab\grab.ico" />
    <Property Id="ARPPRODUCTICON" Value="GrabIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/urbanspress/grab.stable/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/urbanspress/grab.stable" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/urbanspress/grab.stable/releases" />

    <!-- Override WiX built-in UI bitmaps (eliminates red default placeholder flash on startup) -->
    <WixVariable Id="WixUIDialogBmp" Value="wizard-welcome.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="wizard-header.bmp" />

    <!-- Install Directory & Default Options -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ADD_TO_PATH" Value="1" />

    <!-- Companion Tool Detection (Registry + ProgramFiles64Folder) -->
    <Property Id="DOCKER_REG">
      <RegistrySearch Id="DockerRegSearch" Root="HKLM" Key="SOFTWARE\Docker Inc.\Docker\1.0" Type="raw" />
    </Property>
    <Property Id="DOCKER_UNINST">
      <RegistrySearch Id="DockerUninstSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Docker Desktop" Name="DisplayName" Type="raw" />
    </Property>
    <Property Id="DOCKER_EXE">
      <DirectorySearch Id="DockerDirSearch" Path="[ProgramFiles64Folder]Docker\Docker">
        <FileSearch Id="DockerFileSearch" Name="Docker Desktop.exe" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="DOCKER_INSTALLED" Value="1" After="AppSearch" Condition="DOCKER_REG OR DOCKER_UNINST OR DOCKER_EXE" />

    <Property Id="GIT_REG_LM">
      <RegistrySearch Id="GitRegLMSearch" Root="HKLM" Key="SOFTWARE\GitForWindows" Name="InstallPath" Type="raw" />
    </Property>
    <Property Id="GIT_REG_CU">
      <RegistrySearch Id="GitRegCUSearch" Root="HKCU" Key="SOFTWARE\GitForWindows" Name="InstallPath" Type="raw" />
    </Property>
    <Property Id="GIT_EXE">
      <DirectorySearch Id="GitDirSearch" Path="[ProgramFiles64Folder]Git\cmd">
        <FileSearch Id="GitFileSearch" Name="git.exe" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="GIT_INSTALLED" Value="1" After="AppSearch" Condition="GIT_REG_LM OR GIT_REG_CU OR GIT_EXE" />

    <Property Id="GO_REG">
      <RegistrySearch Id="GoRegSearch" Root="HKLM" Key="SOFTWARE\GoProgrammingLanguage" Name="InstallLocation" Type="raw" />
    </Property>
    <Property Id="GO_EXE_PF">
      <DirectorySearch Id="GoPFDirSearch" Path="[ProgramFiles64Folder]Go\bin">
        <FileSearch Id="GoPFFileSearch" Name="go.exe" />
      </DirectorySearch>
    </Property>
    <Property Id="GO_EXE_C">
      <DirectorySearch Id="GoCDirSearch" Path="C:\Go\bin">
        <FileSearch Id="GoCFileSearch" Name="go.exe" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="GO_INSTALLED" Value="1" After="AppSearch" Condition="GO_REG OR GO_EXE_PF OR GO_EXE_C" />

    <!-- Optional winget launch for user-selected companion tools on Finish -->
    <Property Id="POWERSHELL_EXE" Value="powershell.exe" />
    <CustomAction Id="LaunchSelectedTools"
                  Property="POWERSHELL_EXE"
                  ExeCommand="-NoProfile -ExecutionPolicy Bypass -Command &quot;if ('[INSTALL_DOCKER]' -eq '1') { Write-Host 'Installing Docker Desktop...'; winget install -e --id Docker.DockerDesktop --accept-source-agreements --accept-package-agreements }; if ('[INSTALL_GIT]' -eq '1') { Write-Host 'Installing Git for Windows...'; winget install -e --id Git.Git --accept-source-agreements --accept-package-agreements }; if ('[INSTALL_GO]' -eq '1') { Write-Host 'Installing Go Toolchain...'; winget install -e --id GoLang.Go --accept-source-agreements --accept-package-agreements }; Write-Host ''; Read-Host 'Optional tool setup finished. Press Enter to close'&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <!-- Installation Directory & Components -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GRAB">
        <Component Id="GrabBinaryComponent" Guid="A1B2C3D4-E5F6-4789-ABCD-100000000001">
          <File Id="GrabExeFile" Source="..\..\dist\grab-windows-amd64.exe" Name="grab.exe" KeyPath="yes" />
        </Component>
        <Component Id="GrabLicenseComponent" Guid="A1B2C3D4-E5F6-4789-ABCD-100000000002">
          <File Id="LicenseFile" Source="..\..\LICENSE" Name="LICENSE" KeyPath="yes" />
        </Component>
        <Component Id="GrabPathComponent" Guid="A1B2C3D4-E5F6-4789-ABCD-100000000003" Condition="ADD_TO_PATH = &quot;1&quot;">
          <CreateFolder />
          <Environment Id="GRAB_PATH"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="GRAB 1.1.0" Level="1">
      <ComponentRef Id="GrabBinaryComponent" />
      <ComponentRef Id="GrabLicenseComponent" />
      <ComponentRef Id="GrabPathComponent" />
    </Feature>

    <!-- Native 5-Screen Branded WiX UI -->
    <UI Id="GrabUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <TextStyle Id="GrabUI_Font_Bold" FaceName="Segoe UI" Size="8" Bold="yes" />
      <TextStyle Id="GrabUI_Font_Muted" FaceName="Segoe UI" Size="8" Red="90" Green="98" Blue="110" />
      <TextStyle Id="GrabUI_Font_Badge" FaceName="Segoe UI" Size="8" Bold="yes" Red="0" Green="0" Blue="0" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />
      <DialogRef Id="CancelDlg" />

      <!-- Prepare Dialog (matches 460x330 size, zero flicker) -->
      <Dialog Id="GrabPrepareDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup" Modeless="yes">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="165" Height="294" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="182" Y="24" Width="258" Height="45" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Welcome to the GRAB 1.1.0 Setup Wizard" />
        <Control Id="Description" Type="Text" X="182" Y="80" Width="258" Height="40" NoPrefix="yes" Text="Please wait while the Setup Wizard prepares to guide you through the installation." />
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Screen 1: Welcome -->
      <Dialog Id="GrabWelcomeDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="165" Height="294" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="182" Y="24" Width="258" Height="45" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Welcome to the GRAB 1.1.0 Setup Wizard" />
        <Control Id="Description" Type="Text" X="182" Y="80" Width="258" Height="60" NoPrefix="yes" Text="The Setup Wizard will install GRAB v1.1 on your computer. Click Next to continue or Cancel to exit the Setup Wizard." />
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="GrabLicenseAgreementDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Screen 2: End-User License Agreement (Single Checkbox) -->
      <Dialog Id="GrabLicenseAgreementDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="460" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="460" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}End-User License Agreement" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="Please read the following License Agreement carefully." />

        <Control Id="LicenseText" Type="ScrollableText" X="20" Y="56" Width="420" Height="204" Sunken="yes" TabSkip="no">
          <Text SourceFile="LICENSE.rtf" />
        </Control>
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="20" Y="268" Width="420" Height="18" CheckBoxValue="1" Property="LicenseAccepted" Text="I &amp;accept the terms in the License Agreement" />

        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="GrabWelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Text="&amp;Next"
                 DisableCondition="LicenseAccepted &lt;&gt; &quot;1&quot;"
                 EnableCondition="LicenseAccepted = &quot;1&quot;">
          <Publish Event="NewDialog" Value="GrabInstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Screen 3: Destination Folder & Add to PATH -->
      <Dialog Id="GrabInstallDirDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="460" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="460" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Destination Folder" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose where GRAB will be installed on your computer." />

        <Control Id="FolderLabel" Type="Text" X="20" Y="64" Width="420" Height="14" NoPrefix="yes" Text="Install GRAB to:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="80" Width="354" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="382" Y="80" Width="58" Height="18" Text="C&amp;hange...">
          <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>

        <Control Id="AddToPathCheckBox" Type="CheckBox" X="20" Y="118" Width="420" Height="18" CheckBoxValue="1" Property="ADD_TO_PATH" Text="Add GRAB to System PATH (recommended)" />
        <Control Id="PathHint" Type="Text" X="34" Y="138" Width="406" Height="28" NoPrefix="yes" Text="{\GrabUI_Font_Muted}Allows running the 'grab' command from any PowerShell, Command Prompt, or terminal window. Cleanly removed on uninstall." />

        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="GrabLicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
          <Publish Event="NewDialog" Value="GrabToolsDlg" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Screen 4: Tools for GRAB Ecosystem -->
      <Dialog Id="GrabToolsDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="460" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="460" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Tools for GRAB Ecosystem" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="Select optional companion tools to install via winget after setup." />

        <!-- Docker Desktop -->
        <Control Id="DockerCheck" Type="CheckBox" X="20" Y="60" Width="380" Height="16" CheckBoxValue="1" Property="INSTALL_DOCKER" Text="{\GrabUI_Font_Bold}Docker Desktop"
                 HideCondition="DOCKER_INSTALLED" ShowCondition="NOT DOCKER_INSTALLED" />
        <Control Id="DockerInstalledCheck" Type="CheckBox" X="20" Y="60" Width="380" Height="16" CheckBoxValue="1" Property="DOCKER_INSTALLED_DUMMY" Disabled="yes" Text="Docker Desktop (Already installed)"
                 ShowCondition="DOCKER_INSTALLED" HideCondition="NOT DOCKER_INSTALLED" />
        <Control Id="DockerBadge" Type="Text" X="416" Y="60" Width="24" Height="14" NoPrefix="yes" Text="{\GrabUI_Font_Badge}(i)" ToolTip="Runs hardened, read-only Grisp production containers and local Redis, PostgreSQL, or MariaDB databases for GRAB apps." />
        <Control Id="DockerDesc" Type="Text" X="34" Y="78" Width="406" Height="24" NoPrefix="yes" Text="{\GrabUI_Font_Muted}Runs hardened, read-only Grisp production containers and local Redis, PostgreSQL, or MariaDB databases for GRAB apps." />

        <!-- Git for Windows -->
        <Control Id="GitCheck" Type="CheckBox" X="20" Y="112" Width="380" Height="16" CheckBoxValue="1" Property="INSTALL_GIT" Text="{\GrabUI_Font_Bold}Git for Windows"
                 HideCondition="GIT_INSTALLED" ShowCondition="NOT GIT_INSTALLED" />
        <Control Id="GitInstalledCheck" Type="CheckBox" X="20" Y="112" Width="380" Height="16" CheckBoxValue="1" Property="GIT_INSTALLED_DUMMY" Disabled="yes" Text="Git for Windows (Already installed)"
                 ShowCondition="GIT_INSTALLED" HideCondition="NOT GIT_INSTALLED" />
        <Control Id="GitBadge" Type="Text" X="416" Y="112" Width="24" Height="14" NoPrefix="yes" Text="{\GrabUI_Font_Badge}(i)" ToolTip="Clones GRAB starter templates, tracks app version history, and powers grabman ecosystem updates." />
        <Control Id="GitDesc" Type="Text" X="34" Y="130" Width="406" Height="24" NoPrefix="yes" Text="{\GrabUI_Font_Muted}Clones GRAB starter templates, tracks app version history, and powers grabman ecosystem updates." />

        <!-- Go Toolchain -->
        <Control Id="GoCheck" Type="CheckBox" X="20" Y="164" Width="380" Height="16" CheckBoxValue="1" Property="INSTALL_GO" Text="{\GrabUI_Font_Bold}Go Toolchain (Optional — For Source Contributors)"
                 HideCondition="GO_INSTALLED" ShowCondition="NOT GO_INSTALLED" />
        <Control Id="GoInstalledCheck" Type="CheckBox" X="20" Y="164" Width="380" Height="16" CheckBoxValue="1" Property="GO_INSTALLED_DUMMY" Disabled="yes" Text="Go Toolchain (Already installed)"
                 ShowCondition="GO_INSTALLED" HideCondition="NOT GO_INSTALLED" />
        <Control Id="GoBadge" Type="Text" X="416" Y="164" Width="24" Height="14" NoPrefix="yes" Text="{\GrabUI_Font_Badge}(i)" ToolTip="Only needed if you plan to modify or compile GRAB from source; running pre-built GRAB apps does not require Go." />
        <Control Id="GoDesc" Type="Text" X="34" Y="182" Width="406" Height="24" NoPrefix="yes" Text="{\GrabUI_Font_Muted}Only needed if you plan to modify or compile GRAB from source; running pre-built GRAB apps does not require Go." />

        <Control Id="ToolsNote" Type="Text" X="20" Y="254" Width="420" Height="22" NoPrefix="yes" Text="{\GrabUI_Font_Muted}Checked tools will be installed via winget after GRAB setup finishes." />

        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="GrabInstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="GrabVerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Verify Ready Dialog (460x330) -->
      <Dialog Id="GrabVerifyReadyDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup" TrackDiskSpace="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="460" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="460" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Ready to install GRAB 1.1.0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="Click Install to begin the installation." />
        <Control Id="BodyText" Type="Text" X="20" Y="64" Width="420" Height="40" NoPrefix="yes" Text="Click Install to begin the installation. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." />
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="GrabToolsDlg" Order="1" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
        </Control>
        <Control Id="Install" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" ElevationShield="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Progress Dialog (460x330) -->
      <Dialog Id="GrabProgressDlg" Width="460" Height="330" Title="GRAB 1.1.0 Setup" Modeless="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="460" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="460" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installing GRAB 1.1.0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="360" Height="15" Transparent="yes" NoPrefix="yes" Text="Please wait while the Setup Wizard installs GRAB 1.1.0." />
        <Control Id="StatusLabel" Type="Text" X="20" Y="100" Width="420" Height="16" NoPrefix="yes" Text="Status:">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="120" Width="420" Height="14" ProgressBlocks="yes" Text="Progress done">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="326" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Screen 5a: Native Completion Dialog -->
      <Dialog Id="GrabExitDialog" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="165" Height="294" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="182" Y="24" Width="258" Height="40" NoPrefix="yes" Text="{\WixUI_Font_Bigger}Completed the GRAB 1.1.0 Setup Wizard" />
        <Control Id="Description" Type="Text" X="182" Y="80" Width="258" Height="60" NoPrefix="yes" Text="Click the Finish button to exit the Setup Wizard." />
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Finish" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="DoAction" Value="LaunchSelectedTools" Order="1" Condition="INSTALL_DOCKER = &quot;1&quot; OR INSTALL_GIT = &quot;1&quot; OR INSTALL_GO = &quot;1&quot;" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Disabled="yes" Text="Cancel" />
      </Dialog>

      <!-- Screen 5b: Native Windows Installer Interruption Dialog -->
      <Dialog Id="GrabUserExit" Width="460" Height="330" Title="GRAB 1.1.0 Setup">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="165" Height="294" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="294" Width="460" Height="0" />
        <Control Id="Title" Type="Text" X="182" Y="24" Width="258" Height="40" NoPrefix="yes" Text="{\WixUI_Font_Bigger}GRAB Setup Wizard was interrupted" />
        <Control Id="Description" Type="Text" X="182" Y="80" Width="258" Height="60" NoPrefix="yes" Text="GRAB Setup Wizard was interrupted — Your system has not been modified. No GRAB files or folders were installed." />
        <Control Id="FinishNote" Type="Text" X="182" Y="146" Width="258" Height="30" NoPrefix="yes" Text="Click Finish to exit the Setup Wizard." />
        <Control Id="Back" Type="PushButton" X="270" Y="303" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Finish" Type="PushButton" X="326" Y="303" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="394" Y="303" Width="56" Height="17" Disabled="yes" Text="Cancel" />
      </Dialog>

      <!-- Wire standard WixUI navigation to our 5-screen flow -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="GrabVerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="GrabVerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <InstallUISequence>
        <Show Dialog="GrabPrepareDlg" Before="AppSearch" />
        <Show Dialog="GrabWelcomeDlg" Before="GrabProgressDlg" Condition="NOT Installed" />
        <Show Dialog="GrabProgressDlg" Before="ExecuteAction" />
        <Show Dialog="GrabExitDialog" OnExit="success" />
        <Show Dialog="GrabUserExit" OnExit="cancel" />
      </InstallUISequence>

      <UIRef Id="WixUI_Common" />
    </UI>
  </Package>
</Wix>
